<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Remote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/round_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
        <item name="android:hapticFeedbackEnabled">true</item>
    </style>
</resources>
