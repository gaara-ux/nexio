<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- Top bar: change TV, name + status, power -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_devices"
            style="@style/RoundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/devices"
            android:src="@drawable/ic_devices" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Voice to the TV assistant: hidden until it works (the TV heard no speech). -->
        <ImageButton
            android:id="@+id/btn_voice"
            style="@style/RoundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/voice"
            android:src="@drawable/ic_mic"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_apps"
            style="@style/RoundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Ouvrir une appli sur la TV"
            android:src="@drawable/ic_apps" />

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/RoundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Plus : minuterie, réglages"
            android:src="@drawable/ic_more" />

        <ImageButton
            android:id="@+id/btn_power"
            style="@style/RoundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/power"
            android:src="@drawable/ic_power" />
    </LinearLayout>

    <!-- ===== Tabs: remote (below), files and transfers (added in code) ===== -->
    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/tab_remote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- ===== Remote controls ===== -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- The D-pad takes the room left by the buttons (smaller screens: smaller circle). -->
        <com.gaara.remote.DpadView
            android:id="@+id/dpad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- Buttons: under the D-pad in portrait, beside it in landscape (RemoteActivity.adaptLayout). -->
        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

        <!-- Navigation row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                style="@style/RoundButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_home"
                style="@style/RoundButton"
                android:contentDescription="@string/home"
                android:src="@drawable/ic_home" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/RoundButton"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <!-- Media row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_rewind"
                style="@style/RoundButton"
                android:contentDescription="@string/rewind"
                android:src="@drawable/ic_rewind" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_play"
                style="@style/RoundButton"
                android:contentDescription="@string/play_pause"
                android:src="@drawable/ic_play_pause" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_forward"
                style="@style/RoundButton"
                android:contentDescription="@string/forward"
                android:src="@drawable/ic_forward" />
        </LinearLayout>

        <!-- Volume: one pill with minus / mute / plus -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_vol_down"
                style="@style/RoundButton"
                android:contentDescription="@string/vol_down"
                android:src="@drawable/ic_vol_down" />

            <TextView
                android:id="@+id/tv_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_mute"
                style="@style/RoundButton"
                android:contentDescription="@string/mute"
                android:src="@drawable/ic_mute" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_vol_up"
                style="@style/RoundButton"
                android:contentDescription="@string/vol_up"
                android:src="@drawable/ic_vol_up" />
        </LinearLayout>

        <!-- Text: keyboard and dictation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_keyboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/pill_button"
                android:contentDescription="@string/keyboard"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_keyboard"
                    android:tint="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/keyboard"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Text panel (replaces the controls while typing) ===== -->
    <LinearLayout
        android:id="@+id/text_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/text_title"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/text_hint"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Field + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/text_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/text_input_hint"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="text"
                android:maxLines="3"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btn_mic"
                style="@style/RoundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/dictate"
                android:src="@drawable/ic_mic" />

            <ImageButton
                android:id="@+id/btn_send"
                style="@style/RoundButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/send"
                android:src="@drawable/ic_send"
                android:tint="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_text_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/text_close"
            android:textColor="@color/accent"
            android:textSize="15sp" />
    </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <!-- ===== Bottom tabs ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/pill"
        android:orientation="horizontal" />
</LinearLayout>
